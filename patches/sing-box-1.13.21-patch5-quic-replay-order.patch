+// Reuse the pinned upstream's static Chrome Initial fixtures. This performs no
+// socket capture and exercises the actual QUIC decrypt/fragment/sniff path.
+func replayQUICFixture(t *testing.T, name string) [][]byte {
+	t.Helper()
+	file, err := parser.ParseFile(token.NewFileSet(), "../common/sniff/quic_test.go", nil, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var packets [][]byte
+	for _, declaration := range file.Decls {
+		function, ok := declaration.(*ast.FuncDecl)
+		if !ok || function.Name.Name != name {
+			continue
+		}
+		ast.Inspect(function.Body, func(node ast.Node) bool {
+			call, ok := node.(*ast.CallExpr)
+			if !ok {
+				return true
+			}
+			selector, ok := call.Fun.(*ast.SelectorExpr)
+			if !ok || selector.Sel.Name != "DecodeString" {
+				return true
+			}
+			text, err := strconv.Unquote(call.Args[0].(*ast.BasicLit).Value)
+			if err != nil {
+				t.Fatal(err)
+			}
+			packet, err := hex.DecodeString(text)
+			if err != nil {
+				t.Fatal(err)
+			}
+			packets = append(packets, packet)
+			return true
+		})
+	}
+	if len(packets) == 0 {
+		t.Fatalf("upstream QUIC fixture missing: %s", name)
+	}
+	return packets
+}
+
+type replayPacket struct {
+	data    []byte
+	address M.Socksaddr
+	err     error
+}
+type replayInput struct {
+	events  []replayPacket
+	buffers []*buf.Buffer
+	index   int
+	closed  bool
+}
+
+func (c *replayInput) ReadPacket(buffer *buf.Buffer) (M.Socksaddr, error) {
+	c.buffers = append(c.buffers, buffer)
+	if c.index == len(c.events) {
+		return M.Socksaddr{}, io.EOF
+	}
+	event := c.events[c.index]
+	c.index++
+	if event.err != nil {
+		return M.Socksaddr{}, event.err
+	}
+	_, err := buffer.Write(event.data)
+	return event.address, err
+}
+func (c *replayInput) WritePacket(buffer *buf.Buffer, _ M.Socksaddr) error {
+	buffer.Release()
+	return os.ErrInvalid
+}
+func (c *replayInput) Close() error                     { c.closed = true; return nil }
+func (c *replayInput) LocalAddr() net.Addr              { return M.ParseSocksaddr("192.0.2.100:50000") }
+func (c *replayInput) SetDeadline(time.Time) error      { return nil }
+func (c *replayInput) SetReadDeadline(time.Time) error  { return nil }
+func (c *replayInput) SetWriteDeadline(time.Time) error { return nil }
+
+type replayOutbound struct {
+	adapter.Outbound
+	tag      string
+	called   bool
+	metadata adapter.InboundContext
+	packets  []replayPacket
+	err      error
+}
+
+func (o *replayOutbound) Tag() string       { return o.tag }
+func (o *replayOutbound) Network() []string { return []string{N.NetworkUDP} }
+func (o *replayOutbound) NewPacketConnectionEx(_ context.Context, conn N.PacketConn, metadata adapter.InboundContext, _ N.CloseHandlerFunc) {
+	o.called, o.metadata = true, metadata
+	_, o.err = bufio.CopyPacket(o, conn)
+	conn.Close()
+}
+func (o *replayOutbound) WritePacket(buffer *buf.Buffer, address M.Socksaddr) error {
+	o.packets = append(o.packets, replayPacket{data: append([]byte(nil), buffer.Bytes()...), address: address})
+	buffer.Release()
+	return nil
+}
+
+type replayOutbounds struct {
+	adapter.OutboundManager
+	outline, direct *replayOutbound
+}
+
+func (m replayOutbounds) Default() adapter.Outbound { return m.direct }
+func (m replayOutbounds) Outbound(tag string) (adapter.Outbound, bool) {
+	return m.outline, tag == "outline"
+}
+
+type replayDNSTransports struct{ adapter.DNSTransportManager }
+
+func (replayDNSTransports) FakeIP() adapter.FakeIPTransport { return nil }
+
+type replayDNS struct{ adapter.DNSRouter }
+
+func (replayDNS) LookupReverseMapping(netip.Addr) (string, bool) { return "", false }
+
+type replayTracker struct{ upload, download int64 }
+
+func (t *replayTracker) RoutedConnection(_ context.Context, conn net.Conn, _ adapter.InboundContext, _ adapter.Rule, _ adapter.Outbound) net.Conn {
+	return conn
+}
+func (t *replayTracker) RoutedPacketConnection(_ context.Context, conn N.PacketConn, _ adapter.InboundContext, _ adapter.Rule, _ adapter.Outbound) N.PacketConn {
+	return bufio.NewCounterPacketConn(conn, []N.CountFunc{func(n int64) { t.upload += n }}, []N.CountFunc{func(n int64) { t.download += n }})
+}
