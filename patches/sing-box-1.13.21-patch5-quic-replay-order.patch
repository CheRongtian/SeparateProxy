+func TestQUICPacketReplay(t *testing.T) {
+	for _, test := range []struct {
+		name, fixture string
+		count         int
+		ending        string
+	}{
+		{"one-success", "TestSniffUQUICChrome115", 1, "success"},
+		{"two-success", "TestSniffQUICChromium", 2, "success"},
+		{"three-success", "TestSniffQUICChromeNew", 3, "success"},
+		{"three-failure-direct", "TestSniffQUICChromeNew", 2, "failure"},
+		{"two-timeout-direct", "TestSniffQUICChromeNew", 2, "timeout"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			packets := replayQUICFixture(t, test.fixture)[:test.count]
+			if test.ending == "failure" {
+				packets = append(packets, []byte{0})
+			}
+			input := &replayInput{}
+			for i, data := range packets {
+				input.events = append(input.events, replayPacket{data: data, address: M.ParseSocksaddr(fmt.Sprintf("192.0.2.%d:%d", i+1, 443+i))})
+			}
+			if test.ending == "timeout" {
+				input.events = append(input.events, replayPacket{err: os.ErrDeadlineExceeded})
+			}
+			outline, direct := &replayOutbound{tag: "outline"}, &replayOutbound{tag: "direct"}
+			counter := &replayTracker{}
+			r := &Router{ctx: context.Background(), logger: logger.NOP(),
+				dnsTransport: replayDNSTransports{}, dns: replayDNS{},
+				outbound: replayOutbounds{outline: outline, direct: direct}, trackers: []adapter.ConnectionTracker{counter}}
+			var rules []option.Rule
+			if err := json.Unmarshal([]byte(`[
+				{"network":"udp","port":443,"action":"sniff","sniffer":["quic"]},
+				{"domain":["google.com","www.google.com"],"action":"route","outbound":"outline","override_address":"www.google.com","udp_domain_nat":true}
+			]`), &rules); err != nil {
+				t.Fatal(err)
+			}
+			if err := r.Initialize(rules, nil); err != nil {
+				t.Fatal(err)
+			}
+			original := M.ParseSocksaddr("192.0.2.90:443")
+			if err := r.routePacketConnection(context.Background(), input, adapter.InboundContext{Destination: original}, nil); err != nil {
+				t.Fatal(err)
+			}
+			selected, unused := outline, direct
+			if test.ending != "success" {
+				selected, unused = direct, outline
+			}
+			if unused.called || !selected.called {
+				t.Fatal("sniff result changed final routing")
+			}
+			if !errors.Is(selected.err, io.EOF) {
+				t.Fatalf("copy did not reach normal input end: %v", selected.err)
+			}
+			if len(selected.packets) != len(packets) {
+				t.Fatalf("packet count changed: %d", len(selected.packets))
+			}
+			var expectedBytes int64
+			for i, expected := range input.events[:len(packets)] {
+				got := selected.packets[i]
+				if !bytes.Equal(got.data, expected.data) || got.address != expected.address {
+					t.Fatalf("packet %d replayed out of order or with another destination: got %v expected %v", i+1, got.address, expected.address)
+				}
+				expectedBytes += int64(len(expected.data))
+			}
+			if counter.upload != expectedBytes || counter.download != 0 {
+				t.Fatalf("accounting changed: %+v", counter)
+			}
+			if !input.closed {
+				t.Fatal("cached chain did not close the original connection")
+			}
+			for i, buffer := range input.buffers {
+				if buffer.Cap() != 0 {
+					t.Fatalf("buffer %d was not released", i)
+				}
+			}
+			if test.ending == "success" {
+				if selected.metadata.Domain == "" || selected.metadata.RouteOriginalDestination != original ||
+					selected.metadata.Destination.Fqdn != "www.google.com" || !selected.metadata.UDPDomainNAT {
+					t.Fatalf("route override/original address/UDP option changed: %+v", selected.metadata)
+				}
+			} else if selected.metadata.Destination != original || selected.metadata.UDPDomainNAT {
+				t.Fatal("failed sniff changed Direct destination or enabled domain NAT")
+			}
+		})
+	}
+}
