+// CloseWrite serializes FIN with every encrypted write, including the initial
+// target header. It leaves the response reader and the tracked connection alive.
+func (c *clientConn) CloseWrite() error {
+	c.writeAccess.Lock()
+	defer c.writeAccess.Unlock()
+	if c.writeClosed {
+		return c.writeCloseErr
+	}
+	c.writeClosed = true
+	writer, _ := N.UnwrapCountWriter(c.Conn, nil)
+	duplex, ok := N.UnwrapWriter(writer).(N.WriteCloser)
+	if !ok {
+		c.writeCloseErr = errors.ErrUnsupported
+		return c.writeCloseErr
+	}
+	if c.writer == nil {
+		// This is the existing AEAD target-header handshake, not an empty-write
+		// flush. Its buffered header is fully written before the TCP FIN.
+		if err := c.writeRequest(nil); err != nil {
