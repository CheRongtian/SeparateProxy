+
+type memoryConn struct {
+	reader *bytes.Reader
+	writer bytes.Buffer
+}
+
+func (c *memoryConn) Read(data []byte) (int, error)    { return c.reader.Read(data) }
+func (c *memoryConn) Write(data []byte) (int, error)   { return c.writer.Write(data) }
+func (c *memoryConn) Close() error                     { return nil }
+func (c *memoryConn) LocalAddr() net.Addr              { return &net.UnixAddr{Name: "local"} }
+func (c *memoryConn) RemoteAddr() net.Addr             { return &net.UnixAddr{Name: "remote"} }
+func (c *memoryConn) SetDeadline(time.Time) error      { return nil }
+func (c *memoryConn) SetReadDeadline(time.Time) error  { return nil }
+func (c *memoryConn) SetWriteDeadline(time.Time) error { return nil }
+
+type memoryPacketConn struct {
+	readPayload []byte
+	writes      [][]byte
+}
+
+func (c *memoryPacketConn) ReadPacket(buffer *buf.Buffer) (M.Socksaddr, error) {
+	_, err := buffer.Write(c.readPayload)
+	return M.Socksaddr{}, err
+}
+
+func (c *memoryPacketConn) WritePacket(buffer *buf.Buffer, _ M.Socksaddr) error {
+	c.writes = append(c.writes, bytes.Clone(buffer.Bytes()))
+	return nil
+}
+
+func (c *memoryPacketConn) Close() error                     { return nil }
+func (c *memoryPacketConn) LocalAddr() net.Addr              { return &net.UnixAddr{Name: "local"} }
+func (c *memoryPacketConn) SetDeadline(time.Time) error      { return nil }
+func (c *memoryPacketConn) SetReadDeadline(time.Time) error  { return nil }
+func (c *memoryPacketConn) SetWriteDeadline(time.Time) error { return nil }
+
+var _ net.Conn = (*memoryConn)(nil)
+var _ N.PacketConn = (*memoryPacketConn)(nil)

