+)
+
+func TestTCPAccountingDirectionsAndIsolation(t *testing.T) {
+	tests := []struct {
+		name     string
+		tag      string
+		expected Snapshot
+	}{
+		{
+			name: "outline",
+			tag:  "outline",
+			expected: Snapshot{
+				ProxyUploadBytes:   6,
+				ProxyDownloadBytes: 8,
+			},
+		},
+		{
+			name: "direct",
+			tag:  "direct",
+			expected: Snapshot{
+				DirectUploadBytes:   6,
+				DirectDownloadBytes: 8,
+			},
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			service := newCounterTestService(t)
+			connection := &memoryConn{reader: bytes.NewReader([]byte("upload"))}
+			wrapped := service.RoutedConnection(
+				context.Background(),
+				connection,
+				adapter.InboundContext{},
+				nil,
+				taggedOutbound{tag: test.tag},
+			)
+			readBuffer := make([]byte, 32)
+			readCount, err := wrapped.Read(readBuffer)
+			if err != nil && err != io.EOF {
+				t.Fatal(err)
+			}
+			if readCount != 6 {
+				t.Fatalf("unexpected read count: %d", readCount)
+			}
+			writeCount, err := wrapped.Write([]byte("download"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if writeCount != 8 {
+				t.Fatalf("unexpected write count: %d", writeCount)
+			}
+
+			actual := service.Snapshot()
+			test.expected.Version = snapshotVersion
+			test.expected.SessionIdentifier = actual.SessionIdentifier
+			if actual != test.expected {
+				t.Fatalf("unexpected snapshot: %+v", actual)
+			}
+		})
+	}
+}
+
+func TestUDPAccountingDirectionsAndIsolation(t *testing.T) {
+	for _, tag := range []string{"outline", "direct"} {
+		t.Run(tag, func(t *testing.T) {
+			service := newCounterTestService(t)
+			packetConnection := &memoryPacketConn{readPayload: []byte("uplink")}
+			wrapped := service.RoutedPacketConnection(
+				context.Background(),
+				packetConnection,
+				adapter.InboundContext{},
+				nil,
+				taggedOutbound{tag: tag},
+			)
+			readBuffer := buf.NewPacket()
+			defer readBuffer.Release()
+			if _, err := wrapped.ReadPacket(readBuffer); err != nil {
+				t.Fatal(err)
+			}
+			writeBuffer := buf.As([]byte("downlink"))
+			if err := wrapped.WritePacket(writeBuffer, M.Socksaddr{}); err != nil {
+				t.Fatal(err)
+			}
+
+			snapshot := service.Snapshot()
+			if tag == "outline" {
+				if snapshot.ProxyUploadBytes != 6 || snapshot.ProxyDownloadBytes != 8 ||
+					snapshot.DirectUploadBytes != 0 || snapshot.DirectDownloadBytes != 0 {
+					t.Fatalf("unexpected outline snapshot: %+v", snapshot)
+				}
+			} else if snapshot.DirectUploadBytes != 6 || snapshot.DirectDownloadBytes != 8 ||
+				snapshot.ProxyUploadBytes != 0 || snapshot.ProxyDownloadBytes != 0 {
+				t.Fatalf("unexpected direct snapshot: %+v", snapshot)
+			}
+		})
+	}
+}
+
+func TestUnknownAndUnselectedOutboundsAreNotTracked(t *testing.T) {
+	service := newCounterTestService(t)
+	connection := &memoryConn{reader: bytes.NewReader([]byte("payload"))}
+	if wrapped := service.RoutedConnection(
+		context.Background(), connection, adapter.InboundContext{}, nil, taggedOutbound{tag: "other"},
+	); wrapped != connection {
+		t.Fatal("unknown outbound was wrapped")
+	}
+	if wrapped := service.RoutedConnection(
+		context.Background(), connection, adapter.InboundContext{}, nil, nil,
+	); wrapped != connection {
+		t.Fatal("missing outbound was wrapped")
+	}
+	assertZeroCounters(t, service.Snapshot())
+}
+
+func TestCountersAreMonotonicAndSnapshotsDoNotReset(t *testing.T) {
+	service := newCounterTestService(t)
+	connection := &memoryConn{reader: bytes.NewReader([]byte("firstsecond"))}
+	wrapped := service.RoutedConnection(
+		context.Background(), connection, adapter.InboundContext{}, nil, taggedOutbound{tag: "outline"},
+	)
+	firstRead := make([]byte, 5)
+	if _, err := wrapped.Read(firstRead); err != nil {
+		t.Fatal(err)
+	}
+	first := service.Snapshot()
+	second := service.Snapshot()
+	if first != second || first.ProxyUploadBytes != 5 {
+		t.Fatalf("snapshot query changed counters: first=%+v second=%+v", first, second)
+	}
+	remaining := make([]byte, 32)
+	if _, err := wrapped.Read(remaining); err != nil && err != io.EOF {
+		t.Fatal(err)
+	}
+	third := service.Snapshot()
+	if third.ProxyUploadBytes < second.ProxyUploadBytes || third.ProxyUploadBytes != 11 {
+		t.Fatalf("counter is not monotonic: second=%+v third=%+v", second, third)
+	}
+}
+
+func TestNewServicesStartAtZeroWithDifferentSessions(t *testing.T) {
+	first := newCounterTestService(t).Snapshot()
+	second := newCounterTestService(t).Snapshot()
+	assertZeroCounters(t, first)
+	assertZeroCounters(t, second)
+	if first.SessionIdentifier == "" || second.SessionIdentifier == "" {
+		t.Fatal("session identifier is empty")
+	}
+	if first.SessionIdentifier == second.SessionIdentifier {
+		t.Fatal("new services reused a session identifier")
+	}
+}
+
+func TestSnapshotJSONSchema(t *testing.T) {
+	snapshot := newCounterTestService(t).Snapshot()
+	data, err := json.Marshal(snapshot)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var object map[string]any
+	if err = json.Unmarshal(data, &object); err != nil {
+		t.Fatal(err)
+	}
+	expectedKeys := []string{
+		"version",
+		"session_identifier",
+		"proxy_upload_bytes",
+		"proxy_download_bytes",
+		"direct_upload_bytes",
+		"direct_download_bytes",
+	}
+	actualKeys := make([]string, 0, len(object))
+	for key := range object {
+		actualKeys = append(actualKeys, key)
+	}
+	if len(actualKeys) != len(expectedKeys) {
+		t.Fatalf("unexpected snapshot keys: %v", actualKeys)
+	}
+	for _, key := range expectedKeys {
+		if _, loaded := object[key]; !loaded {
+			t.Fatalf("missing snapshot key: %s", key)
+		}
+	}
+	if object["version"] != float64(snapshotVersion) {
+		t.Fatalf("unexpected snapshot version: %v", object["version"])
+	}
+}
+
+func TestSocketReturnsOneBoundedSnapshotWithoutRequestAndCloses(t *testing.T) {
+	service, socketPath := newSocketTestService(t)
+	startService(t, service)
+	defer service.Close()
+
+	connection, err := net.DialTimeout("unix", socketPath, time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	data, err := io.ReadAll(connection)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(data) == 0 || len(data) > 4096 {
+		t.Fatalf("unexpected response size: %d", len(data))
+	}
+	var snapshot Snapshot
+	if err = json.Unmarshal(data, &snapshot); err != nil {
+		t.Fatal(err)
+	}
+	if snapshot.Version != snapshotVersion || snapshot.SessionIdentifier == "" {
+		t.Fatalf("unexpected snapshot: %+v", snapshot)
+	}
+	if _, err = connection.Read(make([]byte, 1)); err != io.EOF {
+		t.Fatalf("connection did not close after one snapshot: %v", err)
+	}
+}
+
+func TestSocketModeAndNormalCleanup(t *testing.T) {
+	service, socketPath := newSocketTestService(t)
+	startService(t, service)
+	information, err := os.Lstat(socketPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if information.Mode()&os.ModeSocket == 0 || information.Mode().Perm() != 0o600 {
+		t.Fatalf("unexpected socket mode: %v", information.Mode())
+	}
+	if err = service.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = os.Lstat(socketPath); !os.IsNotExist(err) {
+		t.Fatalf("socket remains after close: %v", err)
+	}
+}
+
+func TestStaleSocketIsSafelyReplaced(t *testing.T) {
+	service, socketPath := newSocketTestService(t)
+	stale, err := net.ListenUnix("unix", &net.UnixAddr{Name: socketPath, Net: "unix"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	stale.SetUnlinkOnClose(false)
+	if err = stale.Close(); err != nil {
+		t.Fatal(err)
+	}
+
+	startService(t, service)
+	defer service.Close()
+	connection, err := net.DialTimeout("unix", socketPath, time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = connection.Close()
+}
+
+func TestRegularFileAtSocketPathIsRetainedAndForwardingCountersWork(t *testing.T) {
+	service, socketPath := newSocketTestService(t)
+	content := []byte("retain")
+	if err := os.WriteFile(socketPath, content, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	startService(t, service)
+	actual, err := os.ReadFile(socketPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(actual, content) {
+		t.Fatalf("regular file changed: %q", actual)
+	}
+
+	connection := &memoryConn{reader: bytes.NewReader([]byte("counted"))}
+	wrapped := service.RoutedConnection(
+		context.Background(), connection, adapter.InboundContext{}, nil, taggedOutbound{tag: "outline"},
+	)
+	if _, err = wrapped.Read(make([]byte, 16)); err != nil && err != io.EOF {
+		t.Fatal(err)
+	}
+	if service.Snapshot().ProxyUploadBytes != 7 {
+		t.Fatal("listener failure disabled forwarding counters")
+	}
+}
+
+func TestSymlinkAtSocketPathIsRetained(t *testing.T) {
+	service, socketPath := newSocketTestService(t)
+	targetPath := filepath.Join(filepath.Dir(socketPath), "target")
+	if err := os.WriteFile(targetPath, []byte("retain"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(targetPath, socketPath); err != nil {
+		t.Fatal(err)
+	}
+	startService(t, service)
+	information, err := os.Lstat(socketPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if information.Mode()&os.ModeSymlink == 0 {
+		t.Fatal("socket-path symlink was removed or followed")
+	}
+}
+
+func TestSocketQueriesDoNotResetCounters(t *testing.T) {
+	service, socketPath := newSocketTestService(t)
+	connection := &memoryConn{reader: bytes.NewReader([]byte("persistent"))}
+	wrapped := service.RoutedConnection(
+		context.Background(), connection, adapter.InboundContext{}, nil, taggedOutbound{tag: "direct"},
+	)
+	if _, err := wrapped.Read(make([]byte, 16)); err != nil && err != io.EOF {
