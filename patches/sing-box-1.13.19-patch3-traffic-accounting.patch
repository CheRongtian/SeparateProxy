+package trafficaccounting
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"net"
+	"os"
+	"path/filepath"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/bufio"
+	N "github.com/sagernet/sing/common/network"
+)
+
+const snapshotVersion = 1
+
+var (
+	_ adapter.ConnectionTracker = (*Service)(nil)
+	_ adapter.LifecycleService  = (*Service)(nil)
+)
+
+type Snapshot struct {
+	Version             int    `json:"version"`
+	SessionIdentifier   string `json:"session_identifier"`
+	ProxyUploadBytes    uint64 `json:"proxy_upload_bytes"`
+	ProxyDownloadBytes  uint64 `json:"proxy_download_bytes"`
+	DirectUploadBytes   uint64 `json:"direct_upload_bytes"`
+	DirectDownloadBytes uint64 `json:"direct_download_bytes"`
+}
+
+type Service struct {
+	logger                   log.ContextLogger
+	socketPath               string
+	expectedOwner            uint32
+	sessionIdentifier        string
+	initializationError      error
+	outlineUploadBytes       atomic.Uint64
+	outlineDownloadBytes     atomic.Uint64
+	directUploadBytes        atomic.Uint64
+	directDownloadBytes      atomic.Uint64
+	listenerAccess           sync.Mutex
+	listener                 *net.UnixListener
+	listenerCreated          bool
+	listenerStartAttempted   bool
+	listenerClosed           atomic.Bool
+	listenerAcceptLoopWaiter sync.WaitGroup
+}
+
+func New(logger log.ContextLogger, options option.TrafficAccountingOptions) *Service {
+	return newService(logger, options, 0)
+}
+
+func newService(logger log.ContextLogger, options option.TrafficAccountingOptions, expectedOwner uint32) *Service {
+	sessionIdentifier, err := generateSessionIdentifier()
+	return &Service{
+		logger:              logger,
+		socketPath:          options.SocketPath,
+		expectedOwner:       expectedOwner,
+		sessionIdentifier:   sessionIdentifier,
+		initializationError: err,
+	}
+}
+
+func (s *Service) Name() string {
+	return "traffic accounting"
+}
+
+func (s *Service) Start(stage adapter.StartStage) error {
+	if stage != adapter.StartStateStart {
+		return nil
+	}
+	s.listenerAccess.Lock()
+	if s.listenerStartAttempted {
+		s.listenerAccess.Unlock()
+		return nil
+	}
+	s.listenerStartAttempted = true
+	s.listenerAccess.Unlock()
+
+	if s.initializationError != nil {
+		s.logger.Warn("traffic accounting unavailable: ", s.initializationError)
+		return nil
+	}
+	listener, err := s.openListener()
+	if err != nil {
+		s.logger.Warn("traffic accounting unavailable: ", err)
+		return nil
+	}
+
+	s.listenerAccess.Lock()
+	s.listener = listener
+	s.listenerCreated = true
+	s.listenerAccess.Unlock()
+	s.listenerAcceptLoopWaiter.Add(1)
+	go s.acceptLoop(listener)
+	return nil
+}
+
+func (s *Service) Close() error {
+	s.listenerClosed.Store(true)
+	s.listenerAccess.Lock()
+	listener := s.listener
+	created := s.listenerCreated
+	s.listener = nil
+	s.listenerAccess.Unlock()
+	if listener != nil {
+		_ = listener.Close()
+	}
+	s.listenerAcceptLoopWaiter.Wait()
+	if created {
+		_ = removeSocketIfPresent(s.socketPath)
+	}
+	return nil
+}
+
+func (s *Service) RoutedConnection(
+	_ context.Context,
+	conn net.Conn,
+	_ adapter.InboundContext,
+	_ adapter.Rule,
+	matchOutbound adapter.Outbound,
+) net.Conn {
+	if matchOutbound == nil {
+		return conn
+	}
+	switch matchOutbound.Tag() {
+	case "outline":
+		return bufio.NewCounterConn(
+			conn,
+			[]N.CountFunc{s.counter(&s.outlineUploadBytes)},
+			[]N.CountFunc{s.counter(&s.outlineDownloadBytes)},
+		)
+	case "direct":
+		return bufio.NewCounterConn(
+			conn,
+			[]N.CountFunc{s.counter(&s.directUploadBytes)},
+			[]N.CountFunc{s.counter(&s.directDownloadBytes)},
+		)
+	default:
+		return conn
+	}
+}
+
+func (s *Service) RoutedPacketConnection(
+	_ context.Context,
+	conn N.PacketConn,
+	_ adapter.InboundContext,
+	_ adapter.Rule,
+	matchOutbound adapter.Outbound,
+) N.PacketConn {
+	if matchOutbound == nil {
+		return conn
+	}
+	switch matchOutbound.Tag() {
+	case "outline":
+		return bufio.NewCounterPacketConn(
+			conn,
+			[]N.CountFunc{s.counter(&s.outlineUploadBytes)},
+			[]N.CountFunc{s.counter(&s.outlineDownloadBytes)},
+		)
+	case "direct":
+		return bufio.NewCounterPacketConn(
+			conn,
+			[]N.CountFunc{s.counter(&s.directUploadBytes)},
+			[]N.CountFunc{s.counter(&s.directDownloadBytes)},
+		)
+	default:
+		return conn
+	}
+}
+
+func (s *Service) Snapshot() Snapshot {
+	return Snapshot{
+		Version:             snapshotVersion,
+		SessionIdentifier:   s.sessionIdentifier,
+		ProxyUploadBytes:    s.outlineUploadBytes.Load(),
+		ProxyDownloadBytes:  s.outlineDownloadBytes.Load(),
+		DirectUploadBytes:   s.directUploadBytes.Load(),
+		DirectDownloadBytes: s.directDownloadBytes.Load(),
+	}
+}
+
+func (s *Service) counter(value *atomic.Uint64) N.CountFunc {
+	return func(count int64) {
+		if count > 0 {
+			value.Add(uint64(count))
+		}
+	}
+}
+
+func (s *Service) openListener() (*net.UnixListener, error) {
+	if err := validateSocketLocation(s.socketPath, s.expectedOwner); err != nil {
+		return nil, err
+	}
+	if err := removeSocketIfPresent(s.socketPath); err != nil {
+		return nil, err
+	}
+	listener, err := net.ListenUnix("unix", &net.UnixAddr{Name: s.socketPath, Net: "unix"})
+	if err != nil {
+		return nil, fmt.Errorf("listen on traffic socket: %w", err)
+	}
+	listener.SetUnlinkOnClose(false)
+	if err = os.Chmod(s.socketPath, 0o600); err != nil {
+		_ = listener.Close()
+		_ = removeSocketIfPresent(s.socketPath)
+		return nil, fmt.Errorf("set traffic socket permissions: %w", err)
+	}
+	return listener, nil
+}
+
+func (s *Service) acceptLoop(listener *net.UnixListener) {
+	defer s.listenerAcceptLoopWaiter.Done()
+	for {
+		conn, err := listener.AcceptUnix()
+		if err != nil {
+			if !s.listenerClosed.Load() {
+				s.logger.Warn("traffic accounting listener stopped: ", err)
+			}
+			return
+		}
+		s.writeSnapshot(conn)
+	}
+}
+
+func (s *Service) writeSnapshot(conn *net.UnixConn) {
+	defer conn.Close()
+	_ = conn.SetWriteDeadline(time.Now().Add(time.Second))
+	if err := json.NewEncoder(conn).Encode(s.Snapshot()); err != nil {
+		s.logger.Warn("write traffic accounting snapshot: ", err)
+	}
+}
+
+func validateSocketLocation(socketPath string, expectedOwner uint32) error {
+	if !filepath.IsAbs(socketPath) || filepath.Clean(socketPath) != socketPath {
+		return fmt.Errorf("traffic socket path is not canonical")
+	}
+	parentPath := filepath.Dir(socketPath)
+	resolvedParent, err := filepath.EvalSymlinks(parentPath)
+	if err != nil {
+		return fmt.Errorf("resolve traffic socket directory: %w", err)
+	}
+	if resolvedParent != parentPath {
+		return fmt.Errorf("traffic socket directory contains a symbolic link")
+	}
+	information, err := os.Lstat(parentPath)
+	if err != nil {
+		return fmt.Errorf("inspect traffic socket directory: %w", err)
+	}
+	stat, ok := information.Sys().(*syscall.Stat_t)
+	if !ok || stat.Uid != expectedOwner {
+		return fmt.Errorf("inspect traffic socket directory ownership")
+	}
+	if !information.IsDir() || information.Mode().Perm() != 0o700 {
+		return fmt.Errorf("traffic socket directory must be owner-only")
+	}
+	return nil
+}
+
+func removeSocketIfPresent(socketPath string) error {
+	information, err := os.Lstat(socketPath)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return nil
+		}
+		return fmt.Errorf("inspect traffic socket: %w", err)
+	}
+	if information.Mode()&os.ModeSymlink != 0 || information.Mode()&os.ModeSocket == 0 {
+		return fmt.Errorf("refuse to replace non-socket traffic path")
+	}
+	if err = os.Remove(socketPath); err != nil {
+		return fmt.Errorf("remove stale traffic socket: %w", err)
+	}
+	return nil
+}
+
+func generateSessionIdentifier() (string, error) {
+	identifier := make([]byte, 16)
+	if _, err := rand.Read(identifier); err != nil {
+		return "", fmt.Errorf("generate traffic accounting session identifier: %w", err)
+	}
+	return hex.EncodeToString(identifier), nil
+}
