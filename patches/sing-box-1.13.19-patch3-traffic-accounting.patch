+	startService(t, service)
+	defer service.Close()
+	first := readSocketSnapshot(t, socketPath)
+	second := readSocketSnapshot(t, socketPath)
+	if first != second || first.DirectUploadBytes != 10 {
+		t.Fatalf("socket query reset counters: first=%+v second=%+v", first, second)
+	}
+}
+
+func newCounterTestService(t *testing.T) *Service {
+	t.Helper()
+	return newService(
+		log.NewNOPFactory().NewLogger("traffic-accounting-test"),
+		option.TrafficAccountingOptions{Enabled: true},
+		uint32(os.Getuid()),
+	)
+}
+
+func newSocketTestService(t *testing.T) (*Service, string) {
+	t.Helper()
+	directory, err := os.MkdirTemp("/private/tmp", "sp-ta-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = os.RemoveAll(directory) })
+	if err := os.Chmod(directory, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	socketPath := filepath.Join(directory, "traffic.sock")
+	service := newService(
+		log.NewNOPFactory().NewLogger("traffic-accounting-test"),
+		option.TrafficAccountingOptions{Enabled: true, SocketPath: socketPath},
+		uint32(os.Getuid()),
+	)
+	return service, socketPath
+}
+
+func startService(t *testing.T, service *Service) {
+	t.Helper()
+	if err := service.Start(adapter.StartStateStart); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func readSocketSnapshot(t *testing.T, socketPath string) Snapshot {
+	t.Helper()
+	connection, err := net.DialTimeout("unix", socketPath, time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer connection.Close()
+	var snapshot Snapshot
+	if err = json.NewDecoder(io.LimitReader(connection, 4096)).Decode(&snapshot); err != nil {
+		t.Fatal(err)
+	}
+	return snapshot
+}
+
+func assertZeroCounters(t *testing.T, snapshot Snapshot) {
+	t.Helper()
+	if snapshot.Version != snapshotVersion || snapshot.SessionIdentifier == "" ||
+		snapshot.ProxyUploadBytes != 0 || snapshot.ProxyDownloadBytes != 0 ||
+		snapshot.DirectUploadBytes != 0 || snapshot.DirectDownloadBytes != 0 {
+		t.Fatalf("unexpected initial snapshot: %+v", snapshot)
+	}
+}
