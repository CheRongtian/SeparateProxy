+func TestTCPHalfCloseTruncatedShadowsocksResponse(t *testing.T) {
+	app, inbound := tcpHalfClosePair(t)
+	outbound, server := tcpHalfClosePair(t)
+	m := NewConnectionManager(log.NewNOPFactory().NewLogger("half-close"))
+	method, err := shadowaead.NewMethod(context.Background(), "aes-128-gcm", SSC.MethodOptions{Key: []byte("0123456789abcdef")})
+	if err != nil {
+		t.Fatal(err)
+	}
+	target := M.Socksaddr{Fqdn: "truncated.test", Port: 443}
+	serverDone := make(chan error, 1)
+	go func() {
+		r, err := tcpHalfCloseDecode(server)
+		if err == nil {
+			_, err = M.SocksaddrSerializer.ReadAddrPort(r)
+		}
+		if err == nil {
+			_, err = server.Write([]byte{1, 2, 3})
+		}
+		if err == nil {
+			err = server.CloseWrite()
+		}
+		serverDone <- err
+	}()
+	done := make(chan error, 2)
+	var callbacks atomic.Int32
+	d := tcpHalfCloseDialer{dial: func() (net.Conn, error) { return method.DialEarlyConn(m.TrackConn(outbound), target), nil }}
+	m.NewConnection(context.Background(), d, bufio.NewCounterConn(inbound, nil, nil), adapter.InboundContext{Destination: target}, func(err error) { callbacks.Add(1); done <- err })
+	if err := tcpHalfCloseAwait(t, serverDone); err != nil {
+		t.Fatal(err)
+	}
+	if err := tcpHalfCloseAwait(t, done); !errors.Is(err, io.ErrUnexpectedEOF) {
+		t.Fatalf("truncated AEAD response error lost: %v", err)
+	}
+	if tcpHalfCloseCount(m) != 0 || callbacks.Load() != 1 {
+		t.Fatal("truncated response leaked a connection or repeated completion")
+	}
+	app.SetReadDeadline(time.Now().Add(time.Second))
+	if _, err := io.ReadAll(app); err != nil && !errors.Is(err, net.ErrClosed) {
+		t.Fatal(err)
+	}
+}
