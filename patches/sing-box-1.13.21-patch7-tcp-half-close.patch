+// The two TCP copy directions share final cleanup, while each successful EOF
+// closes only its destination's write side. Record the original error before
+// closing sockets wakes the opposite copy with a secondary closed error.
+type tcpCopyState struct {
+	access    sync.Mutex
+	completed int
+	err       error
+	closeOnce sync.Once
+}
+
+func (s *tcpCopyState) finish(err error, fullClose bool, source, destination net.Conn, onClose N.CloseHandlerFunc) {
+	s.access.Lock()
+	if s.err == nil && err != nil {
+		s.err = err
+	}
+	s.completed++
+	last := s.completed == 2
+	result := s.err
+	s.access.Unlock()
+	if err != nil || fullClose || last {
+		s.closeOnce.Do(func() { common.Close(source, destination) })
+	}
+	if last && onClose != nil {
+		onClose(result)
+	}
+}
