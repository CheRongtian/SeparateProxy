+func TestTCPHalfCloseBidirectional(t *testing.T) {
+	for _, direction := range []string{"upload-eof", "download-eof"} {
+		t.Run(direction, func(t *testing.T) {
+			app, inbound := tcpHalfClosePair(t)
+			outbound, server := tcpHalfClosePair(t)
+			manager := NewConnectionManager(log.NewNOPFactory().NewLogger("half-close"))
+			method, err := shadowaead.NewMethod(context.Background(), "aes-128-gcm", SSC.MethodOptions{Key: []byte("0123456789abcdef")})
+			if err != nil {
+				t.Fatal(err)
+			}
+			up := bytes.Repeat([]byte("client payload;"), 3000)
+			down := bytes.Repeat([]byte("server delayed tail;"), 3000)
+			prefix := append([]byte(nil), up[:37]...)
+			cached := bufio.NewCachedConn(inbound, buf.As(prefix))
+			var uploaded, downloaded atomic.Int64
+			counted := bufio.NewCounterConn(cached, []N.CountFunc{func(n int64) { uploaded.Add(n) }}, []N.CountFunc{func(n int64) { downloaded.Add(n) }})
+			target := M.Socksaddr{Fqdn: "half-close.test", Port: 443}
+			half := make(chan struct{}, 1)
+			release := make(chan struct{})
+			serverDone := make(chan error, 1)
+			go func() {
+				r, err := tcpHalfCloseDecode(server)
+				var destination M.Socksaddr
+				if err == nil {
+					destination, err = M.SocksaddrSerializer.ReadAddrPort(r)
+				}
+				if err == nil && destination != target {
+					err = fmt.Errorf("SS destination mismatch: %v", destination)
+				}
+				if err == nil && direction == "download-eof" {
+					err = tcpHalfCloseEncode(server, down)
+					if err == nil {
+						err = server.CloseWrite()
+					}
+				}
+				var body []byte
+				if err == nil {
+					body, err = io.ReadAll(r)
+				}
+				if err == nil && !bytes.Equal(body, up) {
+					err = fmt.Errorf("TCP half-close payload mismatch: upstream bytes=%d want=%d", len(body), len(up))
+				}
+				if direction == "upload-eof" {
+					half <- struct{}{}
+					select {
+					case <-release:
+					case <-time.After(5 * time.Second):
+						err = errors.New("reply gate timed out")
+					}
+					if err == nil {
+						err = tcpHalfCloseEncode(server, down)
+						if err == nil {
+							err = server.CloseWrite()
+						}
+					}
+				}
+				serverDone <- err
+			}()
+			var callbacks atomic.Int32
+			complete := make(chan error, 2)
+			dialer := tcpHalfCloseDialer{dial: func() (net.Conn, error) { return method.DialEarlyConn(manager.TrackConn(outbound), target), nil }}
+			manager.NewConnection(context.Background(), dialer, counted, adapter.InboundContext{Destination: target}, func(err error) { callbacks.Add(1); complete <- err })
+			if direction == "upload-eof" {
+				if _, err = app.Write(up[len(prefix):]); err != nil {
+					t.Fatal(err)
+				}
+				if err = app.CloseWrite(); err != nil {
+					t.Fatal(err)
+				}
+				tcpHalfCloseAwait(t, half)
+				if n := tcpHalfCloseCount(manager); n != 1 {
+					t.Errorf("tracked connection removed before reverse tail: %d", n)
+				}
+				if callbacks.Load() != 0 {
+					t.Error("callback ran before reverse copy ended")
+				}
+				close(release)
+			}
+			data, readErr := io.ReadAll(app)
+			if readErr != nil || !bytes.Equal(data, down) {
+				t.Errorf("TCP half-close payload mismatch: downstream bytes=%d want=%d error=%v", len(data), len(down), readErr)
+			}
+			if direction == "download-eof" {
+				if n := tcpHalfCloseCount(manager); n != 1 {
+					t.Errorf("tracked connection removed before remaining upload: %d", n)
+				}
+				if callbacks.Load() != 0 {
+					t.Error("callback ran before upload ended")
+				}
+				if _, err = app.Write(up[len(prefix):]); err != nil {
+					t.Error(err)
+				}
+				if err = app.CloseWrite(); err != nil {
+					t.Error(err)
+				}
+			}
+			if err = tcpHalfCloseAwait(t, serverDone); err != nil {
+				t.Error(err)
+			}
+			if err = tcpHalfCloseAwait(t, complete); err != nil {
+				t.Error(err)
+			}
+			if tcpHalfCloseCount(manager) != 0 || callbacks.Load() != 1 {
+				t.Fatal("tracking leak or repeated callback")
+			}
+			if uploaded.Load() != int64(len(up)) || downloaded.Load() != int64(len(down)) {
+				t.Fatalf("accounting mismatch: up=%d down=%d", uploaded.Load(), downloaded.Load())
+			}
+		})
+	}
+}
