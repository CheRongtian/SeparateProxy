+
+func (c *tcpCopySource) Upstream() any           { return c.Conn }
+func (c *tcpCopySource) ReaderReplaceable() bool { return true }
+func (c *tcpCopySource) HandshakeFailure(err error) error {
+	if reporter, ok := common.Cast[N.HandshakeFailure](c.Conn); ok {
+		return reporter.HandshakeFailure(err)
+	}
+	return nil
+}
