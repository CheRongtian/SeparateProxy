+type tcpHalfCloseFaultConn struct {
+	net.Conn
+	readErr, writeErr, finErr error
+	closes                    atomic.Int32
+}
+
+func (c *tcpHalfCloseFaultConn) Read(p []byte) (int, error) {
+	if c.readErr != nil {
+		return 0, c.readErr
+	}
+	return c.Conn.Read(p)
+}
+func (c *tcpHalfCloseFaultConn) Write(p []byte) (int, error) {
+	if c.writeErr != nil {
+		return 0, c.writeErr
+	}
+	return c.Conn.Write(p)
+}
+
+func (c *tcpHalfCloseFaultConn) WriteBuffer(buffer *buf.Buffer) error {
+	defer buffer.Release()
+	_, err := c.Write(buffer.Bytes())
+	return err
+}
+func (c *tcpHalfCloseFaultConn) CloseWrite() error {
+	if c.finErr != nil {
+		return c.finErr
+	}
+	return c.Conn.(*net.TCPConn).CloseWrite()
+}
+func (c *tcpHalfCloseFaultConn) Close() error { c.closes.Add(1); return c.Conn.Close() }
+
+type tcpHalfCloseReporter struct {
+	net.Conn
+	reports atomic.Int32
+}
+
+func (c *tcpHalfCloseReporter) HandshakeFailure(error) error {
+	c.reports.Add(1)
+	return nil
+}
+
+func TestTCPHalfCloseErrorCleanup(t *testing.T) {
+	for _, mode := range []string{"read", "write", "reported-write", "half-close"} {
+		t.Run(mode, func(t *testing.T) {
+			app, inbound := tcpHalfClosePair(t)
+			outbound, _ := tcpHalfClosePair(t)
+			failure := errors.New("injected TCP " + mode)
+			source := &tcpHalfCloseFaultConn{Conn: inbound}
+			destination := &tcpHalfCloseFaultConn{Conn: outbound}
+			switch mode {
+			case "read":
+				source.readErr = failure
+			case "write", "reported-write":
+				destination.writeErr = failure
+			case "half-close":
+				destination.finErr = failure
+			}
+			m := NewConnectionManager(log.NewNOPFactory().NewLogger("half-close"))
+			done := make(chan error, 2)
+			var callbacks atomic.Int32
+			d := tcpHalfCloseDialer{dial: func() (net.Conn, error) { return m.TrackConn(destination), nil }}
+			var origin net.Conn = source
+			reporter := &tcpHalfCloseReporter{Conn: source}
+			if mode == "reported-write" {
+				origin = reporter
+			}
+			m.NewConnection(context.Background(), d, bufio.NewCounterConn(origin, nil, nil), adapter.InboundContext{Destination: M.Socksaddr{Fqdn: "fault.test", Port: 443}}, func(err error) { callbacks.Add(1); done <- err })
+			if mode == "write" || mode == "reported-write" {
+				if _, err := app.Write([]byte("trigger write")); err != nil {
+					t.Fatal(err)
+				}
+				app.CloseWrite()
+			}
+			if mode == "half-close" {
+				app.CloseWrite()
+			}
+			if err := tcpHalfCloseAwait(t, done); !errors.Is(err, failure) {
+				t.Fatalf("original copy error lost: %v", err)
+			}
+			if m.Count() != 0 || callbacks.Load() != 1 || source.closes.Load() != 1 || destination.closes.Load() != 1 {
+				t.Fatalf("cleanup mismatch: tracked=%d callback=%d closes=%d/%d", m.Count(), callbacks.Load(), source.closes.Load(), destination.closes.Load())
+			}
+			if mode == "reported-write" && reporter.reports.Load() != 1 {
+				t.Fatal("existing handshake reporter was lost or repeated")
+			}
+		})
+	}
+}
