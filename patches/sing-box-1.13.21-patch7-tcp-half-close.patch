+// Independent SIP004 fixture decoder: real AES-GCM records, HKDF-SHA1,
+// encrypted lengths and little-endian nonces. It does not call clientConn.
+type tcpHalfCloseDecoder struct {
+	conn  io.Reader
+	aead  cipher.AEAD
+	nonce []byte
+	plain []byte
+}
+
+func tcpHalfCloseAEAD(salt []byte) (cipher.AEAD, error) {
+	key := make([]byte, 16)
+	if _, err := io.ReadFull(hkdf.New(sha1.New, []byte("0123456789abcdef"), salt, []byte("ss-subkey")), key); err != nil {
+		return nil, err
+	}
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, err
+	}
+	return cipher.NewGCM(block)
+}
+
+func tcpHalfCloseNonce(n []byte) {
+	for i := range n {
+		n[i]++
+		if n[i] != 0 {
+			break
+		}
+	}
+}
+
+func tcpHalfCloseDecode(conn io.Reader) (*tcpHalfCloseDecoder, error) {
+	salt := make([]byte, 16)
+	if _, err := io.ReadFull(conn, salt); err != nil {
+		return nil, err
+	}
+	aead, err := tcpHalfCloseAEAD(salt)
+	if err != nil {
+		return nil, err
+	}
+	return &tcpHalfCloseDecoder{conn: conn, aead: aead, nonce: make([]byte, aead.NonceSize())}, nil
+}
+
+func (r *tcpHalfCloseDecoder) Read(p []byte) (int, error) {
+	if len(p) == 0 {
+		return 0, nil
+	}
+	for len(r.plain) == 0 {
+		header := make([]byte, 2+r.aead.Overhead())
+		if _, err := io.ReadFull(r.conn, header); err != nil {
+			return 0, err
+		}
+		length, err := r.aead.Open(nil, r.nonce, header, nil)
+		if err != nil {
+			return 0, err
+		}
+		tcpHalfCloseNonce(r.nonce)
+		n := int(binary.BigEndian.Uint16(length))
+		if n > 0x3fff {
+			return 0, errors.New("invalid SS record length")
+		}
+		body := make([]byte, n+r.aead.Overhead())
+		if _, err = io.ReadFull(r.conn, body); err != nil {
+			return 0, err
+		}
+		r.plain, err = r.aead.Open(nil, r.nonce, body, nil)
+		if err != nil {
+			return 0, err
+		}
+		tcpHalfCloseNonce(r.nonce)
+	}
+	n := copy(p, r.plain)
+	r.plain = r.plain[n:]
+	return n, nil
+}
+
+func tcpHalfCloseEncode(conn io.Writer, data []byte) error {
+	salt := bytes.Repeat([]byte{0x63}, 16)
+	aead, err := tcpHalfCloseAEAD(salt)
+	if err != nil {
+		return err
+	}
+	if _, err = conn.Write(salt); err != nil {
+		return err
+	}
+	nonce := make([]byte, aead.NonceSize())
+	for len(data) > 0 {
+		n := min(len(data), 0x3fff)
+		length := []byte{byte(n >> 8), byte(n)}
+		packet := aead.Seal(nil, nonce, length, nil)
+		tcpHalfCloseNonce(nonce)
+		packet = append(packet, aead.Seal(nil, nonce, data[:n], nil)...)
+		tcpHalfCloseNonce(nonce)
+		if _, err = conn.Write(packet); err != nil {
+			return err
+		}
+		data = data[n:]
+	}
+	return nil
+}
