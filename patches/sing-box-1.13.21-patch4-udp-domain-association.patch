+package shadowsocks
+
+import (
+	"net"
+	"os"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing/common/buf"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+func shouldRestoreDomainPacketSource(metadata *adapter.InboundContext, destination M.Socksaddr) bool {
+	return metadata.UDPDomainNAT && metadata.Network == N.NetworkUDP && metadata.Protocol == C.ProtocolQUIC &&
+		metadata.RouteOriginalDestination.IsIP() && metadata.RouteOriginalDestination.Port == 443 &&
+		destination.IsDomain() && destination.Port == 443 && destination.Fqdn == metadata.Domain &&
+		!metadata.UDPConnect && !metadata.UDPDisableDomainUnmapping && !metadata.FakeIP &&
+		len(metadata.DestinationAddresses) == 0
+}
+
+// This wrapper is only installed on a dedicated, non-multiplexed Shadowsocks
+// UDP socket. All requests on it must target the one routed domain. After the
+// Shadowsocks decoder authenticates a reply, restore that domain as its source;
+// the existing route NAT then restores Chrome's original IP. Never learn a
+// global IP/domain mapping or let this association send to a second target.
+type domainPacketConn struct {
+	N.NetPacketConn
+	destination M.Socksaddr
+}
+
+func (c *domainPacketConn) source(source M.Socksaddr) (M.Socksaddr, error) {
+	if source == c.destination || (source.IsIP() && source.Port == c.destination.Port) {
+		return c.destination, nil
+	}
+	return M.Socksaddr{}, os.ErrInvalid
+}
+
+func (c *domainPacketConn) ReadPacket(buffer *buf.Buffer) (M.Socksaddr, error) {
+	source, err := c.NetPacketConn.ReadPacket(buffer)
+	if err != nil {
+		return M.Socksaddr{}, err
+	}
+	return c.source(source)
+}
+
+func (c *domainPacketConn) WritePacket(buffer *buf.Buffer, destination M.Socksaddr) error {
+	if destination != c.destination {
+		buffer.Release()
+		return os.ErrInvalid
+	}
+	return c.NetPacketConn.WritePacket(buffer, destination)
+}
+
+func (c *domainPacketConn) ReadFrom(p []byte) (n int, addr net.Addr, err error) {
+	n, addr, err = c.NetPacketConn.ReadFrom(p)
+	if err != nil {
+		return
+	}
+	source, err := c.source(M.SocksaddrFromNet(addr))
+	if err != nil {
+		return 0, nil, err
+	}
+	return n, source, nil
+}
+
+func (c *domainPacketConn) WriteTo(p []byte, destination net.Addr) (int, error) {
+	if M.SocksaddrFromNet(destination) != c.destination {
+		return 0, os.ErrInvalid
+	}
+	return c.NetPacketConn.WriteTo(p, destination)
+}
+
+// Preserve headroom discovery, but do not expose replaceable reader/writer
+// capabilities: a copy fast path must not bypass the address checks above.
+func (c *domainPacketConn) Upstream() any {
+	return c.NetPacketConn
+}
