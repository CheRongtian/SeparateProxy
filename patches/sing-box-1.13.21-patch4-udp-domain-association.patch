+
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/json"
+)
+
+func TestUDPDomainNATRouteOption(t *testing.T) {
+	for _, test := range []struct {
+		input   string
+		enabled bool
+	}{
+		{`{"action":"route","outbound":"outline","override_address":"chatgpt.com"}`, false},
+		{`{"action":"route","outbound":"outline","override_address":"chatgpt.com","udp_domain_nat":true}`, true},
+		{`{"action":"route","outbound":"outline","override_address":"chatgpt.com","udp_domain_nat":false}`, false},
+	} {
+		var options option.RuleAction
+		if err := json.Unmarshal([]byte(test.input), &options); err != nil {
+			t.Fatal(err)
+		}
+		action, err := NewRuleAction(context.Background(), nil, options)
+		if err != nil {
+			t.Fatal(err)
+		}
+		route := action.(*RuleActionRoute)
+		if route.UDPDomainNAT != test.enabled || route.Outbound != "outline" || route.OverrideAddress.Fqdn != "chatgpt.com" {
+			t.Fatalf("route option was not preserved: %+v", route)
+		}
+	}
+}
