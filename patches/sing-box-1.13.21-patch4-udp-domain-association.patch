+package shadowsocks
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/netip"
+	"os"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/adapter/outbound"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/route"
+	"github.com/sagernet/sing-shadowsocks2/cipher"
+	"github.com/sagernet/sing-shadowsocks2/shadowaead"
+	"github.com/sagernet/sing/common/buf"
+	"github.com/sagernet/sing/common/bufio"
+	"github.com/sagernet/sing/common/logger"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+func domainTestMetadata() adapter.InboundContext {
+	return adapter.InboundContext{
+		Network: N.NetworkUDP, Protocol: C.ProtocolQUIC, Domain: "chatgpt.com", UDPDomainNAT: true,
+		Destination:              M.ParseSocksaddr("chatgpt.com:443"),
+		RouteOriginalDestination: M.ParseSocksaddr("192.0.2.10:443"),
+	}
+}
+
+func TestDomainUDPAssociationScope(t *testing.T) {
+	if m := domainTestMetadata(); !shouldRestoreDomainPacketSource(&m, m.Destination) {
+		t.Fatal("selected QUIC DOMAIN association was not enabled")
+	}
+	for name, change := range map[string]func(*adapter.InboundContext){
+		"default-off":             func(m *adapter.InboundContext) { m.UDPDomainNAT = false },
+		"tcp":                     func(m *adapter.InboundContext) { m.Network = N.NetworkTCP },
+		"not-quic":                func(m *adapter.InboundContext) { m.Protocol = C.ProtocolTLS },
+		"no-original":             func(m *adapter.InboundContext) { m.RouteOriginalDestination = M.Socksaddr{} },
+		"original-domain":         func(m *adapter.InboundContext) { m.RouteOriginalDestination = m.Destination },
+		"other-port":              func(m *adapter.InboundContext) { m.Destination.Port = 8443 },
+		"different-original-port": func(m *adapter.InboundContext) { m.RouteOriginalDestination.Port = 8443 },
+		"different-domain":        func(m *adapter.InboundContext) { m.Domain = "other.example" },
+		"ip-target":               func(m *adapter.InboundContext) { m.Destination = m.RouteOriginalDestination },
+		"resolved-target": func(m *adapter.InboundContext) {
+			m.DestinationAddresses = []netip.Addr{netip.MustParseAddr("192.0.2.20")}
+		},
+		"udp-connect":       func(m *adapter.InboundContext) { m.UDPConnect = true },
+		"disable-unmapping": func(m *adapter.InboundContext) { m.UDPDisableDomainUnmapping = true },
+		"fake-ip":           func(m *adapter.InboundContext) { m.FakeIP = true },
+	} {
+		t.Run(name, func(t *testing.T) {
+			m := domainTestMetadata()
+			change(&m)
+			if shouldRestoreDomainPacketSource(&m, m.Destination) {
+				t.Fatal("unrelated path enabled")
+			}
+		})
+	}
+}
+
+// These use the real ConnectionManager, Shadowsocks codec and existing route
+// NAT. Only the TUN endpoint and outer UDP socket are replaced with memory queues.
+func TestDomainUDPAssociationRoundTrip(t *testing.T) {
+	for _, sameIP := range []bool{true, false} {
+		for _, enabled := range []bool{true, false} {
+			t.Run(fmt.Sprintf("sameIP=%t/enabled=%t", sameIP, enabled), func(t *testing.T) {
+				runDomainRoundTrip(t, 0, sameIP, enabled)
+			})
+		}
+	}
+}
+
+func TestDomainUDPConcurrentAssociations(t *testing.T) {
+	for i := 1; i <= 6; i++ {
+		t.Run(fmt.Sprint(i), func(t *testing.T) {
+			t.Parallel()
+			runDomainRoundTrip(t, i, false, true)
+		})
+	}
+}
+
+func runDomainRoundTrip(t *testing.T, id int, sameIP, enabled bool) {
+	t.Helper()
+	client, server := domainMemoryPair()
+	t.Cleanup(func() { client.Close(); server.Close() })
+	method, err := shadowaead.NewMethod(context.Background(), "aes-256-gcm", cipher.MethodOptions{Password: "test-only-password"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	h := &Outbound{
+		Adapter: outbound.NewAdapter(C.TypeShadowsocks, "outline", []string{N.NetworkTCP, N.NetworkUDP}, nil),
+		logger:  logger.NOP(), dialer: domainMemoryDialer{client}, method: method,
+		serverAddr: M.ParseSocksaddr("192.0.2.1:8388"),
+	}
+	m := domainTestMetadata()
+	m.UDPDomainNAT = enabled
+	m.RouteOriginalDestination = M.ParseSocksaddr(fmt.Sprintf("192.0.2.%d:443", 10+id))
+	m.Destination = M.ParseSocksaddr(fmt.Sprintf("host%d.example:443", id))
+	m.Domain = m.Destination.Fqdn
+	peer := M.ParseSocksaddr(fmt.Sprintf("198.51.100.%d:443", 20+id))
+	if sameIP {
+		peer = m.RouteOriginalDestination
+	}
+	tun := newDomainMemoryPacketConn()
+	var upload, download atomic.Int64
+	counted := bufio.NewCounterPacketConn(tun,
+		[]N.CountFunc{func(n int64) { upload.Add(n) }},
+		[]N.CountFunc{func(n int64) { download.Add(n) }})
+	manager := route.NewConnectionManager(logger.NOP())
+	manager.NewPacketConnection(context.Background(), h, counted, m, nil)
+	t.Cleanup(func() { tun.Close(); manager.Close() })
+	codec := method.DialPacketConn(server)
+	var expectedBytes int64
+	for i := 0; i < 3; i++ {
+		payload := []byte(fmt.Sprintf("association-%d-packet-%d", id, i))
+		expectedBytes += int64(len(payload))
+		tun.in <- domainTestPacket{payload, m.RouteOriginalDestination}
+		buffer := buf.NewPacket()
+		destination, err := codec.ReadPacket(buffer)
+		if err != nil {
+			buffer.Release()
+			t.Fatal(err)
+		}
+		if destination != m.Destination || string(buffer.Bytes()) != string(payload) {
+			buffer.Release()
+			t.Fatal("outbound DOMAIN, payload or association changed")
+		}
+		buffer.Release()
+		if _, err := codec.WriteTo(payload, peer); err != nil {
+			t.Fatal(err)
+		}
+		select {
+		case reply := <-tun.out:
+			expectedSource := peer
+			if enabled {
+				expectedSource = m.RouteOriginalDestination
+			}
+			if reply.address != expectedSource || string(reply.data) != string(payload) {
+				t.Fatalf("wrong reply: %+v, expected %v", reply, expectedSource)
+			}
+		case <-time.After(3 * time.Second):
+			t.Fatal("reply did not reach TUN")
+		}
+	}
+	// Entering the next read proves the previous copy and counter updates finished.
+	for i := 0; i < 4; i++ {
+		select {
+		case <-client.reads:
+		case <-time.After(3 * time.Second):
+			t.Fatal("packet copy did not return to the read loop")
+		}
+	}
+	tun.Close()
+	select {
+	case <-client.done:
+	case <-time.After(3 * time.Second):
+		t.Fatal("association did not close its outer socket")
+	}
+	if upload.Load() != expectedBytes || download.Load() != expectedBytes {
+		t.Fatalf("payload accounting changed: upload=%d download=%d expected=%d", upload.Load(), download.Load(), expectedBytes)
+	}
+}
+
+func TestDomainUDPRejectsSecondTargetAndUnexpectedSource(t *testing.T) {
+	client, server := domainMemoryPair()
+	defer client.Close()
+	defer server.Close()
+	method, err := shadowaead.NewMethod(context.Background(), "aes-256-gcm", cipher.MethodOptions{Password: "test-only-password"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	domain := M.ParseSocksaddr("chatgpt.com:443")
+	wrapped := &domainPacketConn{method.DialPacketConn(client), domain}
+	conn := bufio.NewDestinationNATPacketConn(wrapped, domain, M.ParseSocksaddr("192.0.2.10:443"))
+	if _, err := conn.WriteTo([]byte("other-target"), M.ParseSocksaddr("192.0.2.99:443")); !errors.Is(err, os.ErrInvalid) {
+		t.Fatalf("second destination accepted: %v", err)
+	}
+	if len(server.in) != 0 {
+		t.Fatal("second destination reached Shadowsocks")
+	}
+	buffer := buf.NewPacket()
+	buffer.WriteString("other-target")
+	if err := conn.WritePacket(buffer, M.ParseSocksaddr("192.0.2.99:443")); !errors.Is(err, os.ErrInvalid) {
+		t.Fatalf("packet second destination accepted: %v", err)
+	}
+	for _, source := range []M.Socksaddr{M.ParseSocksaddr("198.51.100.1:8443"), M.ParseSocksaddr("other.example:443"), {}} {
+		if _, err := wrapped.source(source); !errors.Is(err, os.ErrInvalid) {
+			t.Fatalf("unrelated source accepted: %v", source)
+		}
+	}
+	codec := method.DialPacketConn(server)
+	if _, err := codec.WriteTo([]byte("response"), M.ParseSocksaddr("198.51.100.1:443")); err != nil {
+		t.Fatal(err)
+	}
+	data := make([]byte, 1024)
+	n, source, err := conn.ReadFrom(data)
+	if err != nil || source.String() != "192.0.2.10:443" || string(data[:n]) != "response" {
+		t.Fatalf("ReadFrom bypassed NAT: %v %v", source, err)
+	}
+}
+
+func TestDirectUDPAddressSemanticsUnchanged(t *testing.T) {
+	tun, remote := newDomainMemoryPacketConn(), newDomainMemoryPacketConn()
+	defer tun.Close()
+	defer remote.Close()
+	manager := route.NewConnectionManager(logger.NOP())
+	target := M.ParseSocksaddr("192.0.2.8:443")
+	manager.NewPacketConnection(context.Background(), domainDirectDialer{bufio.NewNetPacketConn(remote)}, tun,
+		adapter.InboundContext{Network: N.NetworkUDP, Destination: target}, nil)
+	tun.in <- domainTestPacket{[]byte("direct-request"), target}
+	select {
+	case p := <-remote.out:
+		if p.address != target || string(p.data) != "direct-request" {
+			t.Fatal("Direct destination changed")
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("Direct request missing")
+	}
+	peer := M.ParseSocksaddr("198.51.100.8:443")
+	remote.in <- domainTestPacket{[]byte("direct-reply"), peer}
+	select {
+	case p := <-tun.out:
+		if p.address != peer || string(p.data) != "direct-reply" {
+			t.Fatal("Direct source changed")
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("Direct reply missing")
+	}
+}
+
+type domainTestPacket struct {
+	data    []byte
+	address M.Socksaddr
+}
+type domainMemoryPacketConn struct {
+	in, out chan domainTestPacket
+	done    chan struct{}
+	once    sync.Once
+}
+
+func newDomainMemoryPacketConn() *domainMemoryPacketConn {
+	return &domainMemoryPacketConn{in: make(chan domainTestPacket, 8), out: make(chan domainTestPacket, 8), done: make(chan struct{})}
+}
+func (c *domainMemoryPacketConn) ReadPacket(b *buf.Buffer) (M.Socksaddr, error) {
+	select {
+	case p := <-c.in:
+		_, err := b.Write(p.data)
+		return p.address, err
+	case <-c.done:
+		return M.Socksaddr{}, io.ErrClosedPipe
+	}
+}
+func (c *domainMemoryPacketConn) WritePacket(b *buf.Buffer, address M.Socksaddr) error {
+	defer b.Release()
+	p := domainTestPacket{append([]byte(nil), b.Bytes()...), address}
+	select {
+	case c.out <- p:
+		return nil
+	case <-c.done:
+		return io.ErrClosedPipe
+	}
+}
+func (c *domainMemoryPacketConn) Close() error                     { c.once.Do(func() { close(c.done) }); return nil }
+func (c *domainMemoryPacketConn) LocalAddr() net.Addr              { return M.ParseSocksaddr("192.0.2.100:50000") }
+func (c *domainMemoryPacketConn) SetDeadline(time.Time) error      { return os.ErrInvalid }
+func (c *domainMemoryPacketConn) SetReadDeadline(time.Time) error  { return os.ErrInvalid }
+func (c *domainMemoryPacketConn) SetWriteDeadline(time.Time) error { return os.ErrInvalid }
+
+type domainMemoryConn struct {
+	in    chan []byte
+	reads chan struct{}
+	peer  *domainMemoryConn
+	done  chan struct{}
+	once  sync.Once
+}
+
+func domainMemoryPair() (*domainMemoryConn, *domainMemoryConn) {
+	a := &domainMemoryConn{in: make(chan []byte, 8), reads: make(chan struct{}, 8), done: make(chan struct{})}
+	b := &domainMemoryConn{in: make(chan []byte, 8), reads: make(chan struct{}, 8), done: make(chan struct{})}
+	a.peer = b
+	b.peer = a
+	return a, b
+}
+func (c *domainMemoryConn) Read(p []byte) (int, error) {
+	c.reads <- struct{}{}
+	select {
+	case data := <-c.in:
+		return copy(p, data), nil
+	case <-c.done:
+		return 0, io.ErrClosedPipe
+	case <-time.After(3 * time.Second):
+		return 0, os.ErrDeadlineExceeded
+	}
+}
+func (c *domainMemoryConn) Write(p []byte) (int, error) {
+	select {
+	case c.peer.in <- append([]byte(nil), p...):
+		return len(p), nil
+	case <-c.done:
+		return 0, io.ErrClosedPipe
+	case <-c.peer.done:
+		return 0, io.ErrClosedPipe
+	}
+}
+func (c *domainMemoryConn) Close() error                     { c.once.Do(func() { close(c.done) }); return nil }
+func (c *domainMemoryConn) LocalAddr() net.Addr              { return M.ParseSocksaddr("192.0.2.100:50000") }
+func (c *domainMemoryConn) RemoteAddr() net.Addr             { return M.ParseSocksaddr("192.0.2.1:8388") }
+func (c *domainMemoryConn) SetDeadline(time.Time) error      { return nil }
+func (c *domainMemoryConn) SetReadDeadline(time.Time) error  { return nil }
+func (c *domainMemoryConn) SetWriteDeadline(time.Time) error { return nil }
+
+type domainMemoryDialer struct{ conn net.Conn }
+
+func (d domainMemoryDialer) DialContext(context.Context, string, M.Socksaddr) (net.Conn, error) {
+	return d.conn, nil
+}
+func (d domainMemoryDialer) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	return nil, os.ErrInvalid
+}
+
+type domainDirectDialer struct{ conn net.PacketConn }
+
+func (d domainDirectDialer) DialContext(context.Context, string, M.Socksaddr) (net.Conn, error) {
+	return nil, os.ErrInvalid
+}
+func (d domainDirectDialer) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	return d.conn, nil
+}
